# Copy to .env and fill in. NEVER commit the filled-in .env.

# --- LLM (required: the model interprets operator_notes) ---
LLM_PROVIDER=openai          # openai | anthropic
LLM_API_KEY=                 # your key; leave blank here
LLM_MODEL=gpt-4o-mini        # e.g. gpt-4o-mini, claude-3-5-haiku-20241022, llama-3.3-70b-versatile
# LLM_BASE_URL=              # set for any OpenAI-compatible host:
                             #   Groq       https://api.groq.com/openai/v1
                             #   OpenRouter https://openrouter.ai/api/v1
                             #   Ollama     http://localhost:11434/v1

LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=900
LLM_TIMEOUT_SECONDS=12
LLM_MAX_RETRIES=1

# --- Service ---
API_PORT=5000
LOG_LEVEL=INFO
SELF_CHECK=true              # replay every response and log violations
ENABLE_RULE_FALLBACK=true    # deterministic safety net if the provider fails
